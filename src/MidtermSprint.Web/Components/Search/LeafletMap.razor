@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_mapElement" class="cravemap-map" role="region" aria-label="@AccessibleLabel"></div>

@code {
    [Parameter] public IReadOnlyList<MapMarker> Markers { get; set; } = [];
    [Parameter] public MapLocation Center { get; set; } = new(14.5547, 121.0244);
    [Parameter] public int? SelectedMarkerId { get; set; }
    [Parameter] public bool FitMarkers { get; set; } = true;
    [Parameter] public bool IsPicker { get; set; }
    [Parameter] public int Zoom { get; set; } = 13;
    [Parameter] public string AccessibleLabel { get; set; } = "Map of nearby menu matches";
    [Parameter] public EventCallback<int> OnMarkerSelected { get; set; }
    [Parameter] public EventCallback<MapLocation> OnLocationPicked { get; set; }

    private ElementReference _mapElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<LeafletMap>? _dotnetReference;
    private bool _mapCreated;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/cravemap-map.js");
        }

        var options = new
        {
            latitude = Center.Latitude,
            longitude = Center.Longitude,
            zoom = Zoom,
            isPicker = IsPicker,
            fitMarkers = FitMarkers,
            selectedMarkerId = SelectedMarkerId,
            markers = Markers
        };

        if (!_mapCreated)
        {
            _dotnetReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("createMap", _mapElement, options, _dotnetReference);
            _mapCreated = true;
        }
        else
        {
            await _module.InvokeVoidAsync("updateMap", _mapElement, options);
        }
    }

    [JSInvokable]
    public Task OnLeafletMarkerSelected(int restaurantId) =>
        OnMarkerSelected.InvokeAsync(restaurantId);

    [JSInvokable]
    public Task OnMapLocationPicked(double latitude, double longitude) =>
        OnLocationPicked.InvokeAsync(new MapLocation(latitude, longitude));

    public async ValueTask DisposeAsync()
    {
        _dotnetReference?.Dispose();
        if (_module is not null)
        {
            try
            {
                if (_mapCreated)
                {
                    await _module.InvokeVoidAsync("destroyMap", _mapElement);
                }
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
