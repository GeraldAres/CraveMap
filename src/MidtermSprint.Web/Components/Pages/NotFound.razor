@page "/not-found"
@layout MainLayout

<PageTitle>Page not found — CraveMap</PageTitle>
<section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <span class="mx-auto grid size-20 place-items-center rounded-[1.75rem] bg-[#ffe5d7] text-4xl" aria-hidden="true">🗺️</span>
    <p class="mt-6 text-xs font-extrabold uppercase tracking-[0.16em] text-tomato-dark">Wrong turn?</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">We couldn’t find that page.</h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">That link may have moved, or the page may not exist yet. Let’s get you back to something tasty.</p>
    <NavLink href="/" class="mt-7 inline-flex min-h-12 items-center justify-center rounded-full bg-tomato px-6 font-extrabold text-white hover:bg-tomato-dark">Back to CraveMap</NavLink>
</section>
