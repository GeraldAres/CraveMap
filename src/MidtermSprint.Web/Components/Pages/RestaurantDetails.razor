@page "/restaurants/{Slug}"
@using MidtermSprint.Domain.Entities
@using MidtermSprint.Domain.Enums
@inject IRestaurantRepository RestaurantRepository
@inject ILogger<RestaurantDetails> Logger

@if (_isLoading)
{
    <PageTitle>Loading restaurant — CraveMap</PageTitle>
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8" role="status">
        <p class="text-sm font-semibold text-muted">Loading sample restaurant details…</p>
    </section>
}
else if (_loadError is not null)
{
    <PageTitle>Restaurant unavailable — CraveMap</PageTitle>
    <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6" role="alert">
        <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-tomato-dark">Details interrupted</p>
        <h1 class="mt-2 text-3xl font-black">We couldn’t load this listing.</h1>
        <p class="mt-2 text-sm leading-relaxed text-muted">@_loadError</p>
        <button type="button" class="mt-5 min-h-11 rounded-full bg-tomato px-5 font-extrabold text-white hover:bg-tomato-dark" @onclick="LoadRestaurantAsync">Try again</button>
    </section>
}
else if (_restaurant is null)
{
    <PageTitle>Restaurant not found — CraveMap</PageTitle>
    <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
        <span class="mx-auto grid size-16 place-items-center rounded-2xl bg-[#fff0e8] text-3xl" aria-hidden="true">🍽️</span>
        <h1 class="mt-5 text-3xl font-black">This sample listing isn’t available.</h1>
        <p class="mt-2 text-sm leading-relaxed text-muted">It may have moved or is not currently published.</p>
        <NavLink href="/explore" class="mt-6 inline-flex min-h-11 items-center rounded-full bg-tomato px-5 font-extrabold text-white hover:bg-tomato-dark">Explore sample menus</NavLink>
    </section>
}
else
{
    <PageTitle>@_restaurant.Name — CraveMap</PageTitle>
    <HeadContent>
        <meta name="description" content="@_restaurant.Description" />
    </HeadContent>

    <section class="border-b border-[#eee4d8] bg-[linear-gradient(180deg,#fff4e9_0%,#fffaf3_100%)]">
        <div class="mx-auto max-w-7xl px-4 py-9 sm:px-6 sm:py-12 lg:px-8">
            <NavLink href="/explore" class="text-sm font-bold text-tomato-dark hover:underline">← Back to Explore</NavLink>
            <div class="mt-5 flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                <div class="max-w-3xl">
                    <p class="text-xs font-extrabold uppercase tracking-[0.15em] text-tomato-dark">Fictional sample listing</p>
                    <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">@_restaurant.Name</h1>
                    @if (_restaurant.Rating is { } rating)
                    {
                        <p class="mt-3 text-sm font-bold text-muted"><span aria-hidden="true">★</span> @rating.ToString("0.0") demo rating</p>
                    }
                    <p class="mt-4 text-base leading-relaxed text-muted">@_restaurant.Description</p>
                </div>
                <SaveRestaurantButton Slug="@_restaurant.Slug"
                                      RestaurantName="@_restaurant.Name"
                                      Class="self-start" />
            </div>
        </div>
    </section>

    <div class="mx-auto grid max-w-7xl gap-7 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:px-8">
        <main class="min-w-0 space-y-8">
            <section aria-labelledby="menu-heading">
                <div class="mb-4">
                    <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-tomato-dark">Made for browsing</p>
                    <h2 id="menu-heading" class="mt-1 text-2xl font-black tracking-tight">Sample menu</h2>
                    <p class="mt-1 text-sm text-muted">Prices and availability are fictional examples.</p>
                </div>

                @if (_restaurant.MenuItems.Count == 0)
                {
                    <div class="rounded-2xl border border-dashed border-[#dacbbb] bg-white p-6">
                        <h3 class="font-extrabold">No menu items in this sample listing yet</h3>
                        <p class="mt-1 text-sm text-muted">Check back when this demo dataset includes menu details.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-4">
                        @foreach (var item in _restaurant.MenuItems.OrderBy(item => item.MenuSection ?? "zzz").ThenBy(item => item.Name))
                        {
                            <article class="rounded-2xl border border-[#eee4d8] bg-white p-5 shadow-sm sm:p-6">
                                <div class="flex flex-wrap items-start justify-between gap-3">
                                    <div>
                                        @if (!string.IsNullOrWhiteSpace(item.MenuSection))
                                        {
                                            <p class="text-xs font-extrabold uppercase tracking-[0.12em] text-muted">@item.MenuSection</p>
                                        }
                                        <h3 class="mt-1 text-lg font-extrabold">@item.Name</h3>
                                        <p class="mt-1 text-xs font-semibold text-muted">@item.Cuisine?.Name</p>
                                    </div>
                                    <div class="flex flex-col items-end gap-2">
                                        <span class="rounded-full bg-[#fff0e8] px-3 py-1.5 text-sm font-extrabold text-tomato-dark">₱@item.Price.ToString("0.##")</span>
                                        <span class="text-xs font-bold @(item.IsAvailable ? "text-leaf" : "text-muted")">@(item.IsAvailable ? "Sample availability: listed" : "Sample availability: unavailable")</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <p class="mt-3 text-sm leading-relaxed text-muted">@item.Description</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Ingredients))
                                {
                                    <p class="mt-3 text-sm leading-relaxed"><span class="font-bold">Sample ingredients:</span> @item.Ingredients</p>
                                }
                                @if (item.Niches.Count > 0 || item.Characteristics.Count > 0)
                                {
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        @foreach (var niche in item.Niches.Where(link => link.FoodNiche is not null))
                                        {
                                            <span class="rounded-full bg-[#f8f3ec] px-3 py-1 text-xs font-bold text-muted">@niche.FoodNiche!.Name</span>
                                        }
                                        @foreach (var characteristic in item.Characteristics.Where(link => link.Characteristic is not null))
                                        {
                                            <span class="rounded-full bg-[#f8f3ec] px-3 py-1 text-xs font-bold text-muted">@characteristic.Characteristic!.Name</span>
                                        }
                                    </div>
                                }
                                @if (item.DietaryAttributes.Count > 0)
                                {
                                    <div class="mt-4">
                                        <h4 class="text-xs font-extrabold uppercase tracking-[0.1em] text-muted">Dietary tags in sample data</h4>
                                        <ul class="mt-2 flex flex-wrap gap-2">
                                            @foreach (var dietaryTag in item.DietaryAttributes.Where(tag => tag.DietaryPreference is not null))
                                            {
                                                <li class="rounded-full border border-[#d9e7d3] bg-[#f0f6ed] px-3 py-1 text-xs font-bold text-leaf">
                                                    @dietaryTag.DietaryPreference!.Name — @(dietaryTag.IsVerified ? "marked verified in sample" : "unverified sample tag")
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (item.Allergens.Count > 0)
                                {
                                    <div class="mt-4 rounded-xl border border-[#efd4ac] bg-[#fff8e9] p-4">
                                        <h4 class="text-xs font-extrabold uppercase tracking-[0.1em] text-[#654c20]">Allergen evidence in sample data</h4>
                                        <ul class="mt-2 space-y-2 text-sm text-[#654c20]">
                                            @foreach (var evidence in item.Allergens.Where(evidence => evidence.Allergen is not null))
                                            {
                                                <li>
                                                    <span class="font-bold">@evidence.Allergen!.Name:</span> @FormatEvidence(evidence.EvidenceStatus)
                                                    @if (!string.IsNullOrWhiteSpace(evidence.CrossContactNote))
                                                    {
                                                        <span> — @evidence.CrossContactNote</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(evidence.Notes))
                                                    {
                                                        <span> (@evidence.Notes)</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </main>

        <aside class="space-y-5">
            <section class="rounded-2xl border border-[#eee4d8] bg-white p-5" aria-labelledby="visit-heading">
                <h2 id="visit-heading" class="text-lg font-extrabold">Visit details</h2>
                <dl class="mt-4 space-y-4 text-sm">
                    <div>
                        <dt class="font-bold text-muted">Address</dt>
                        <dd class="mt-1 leading-relaxed">@_restaurant.Address</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_restaurant.Phone))
                    {
                        <div>
                            <dt class="font-bold text-muted">Phone</dt>
                            <dd class="mt-1"><a class="font-bold text-tomato-dark hover:underline" href="@($"tel:{Uri.EscapeDataString(_restaurant.Phone)}")">@_restaurant.Phone</a></dd>
                        </div>
                    }
                    @if (TryGetHttpWebsite(_restaurant.Website) is { } website)
                    {
                        <div>
                            <dt class="font-bold text-muted">Website</dt>
                            <dd class="mt-1"><a class="break-all font-bold text-tomato-dark hover:underline" href="@website" target="_blank" rel="noopener noreferrer">Visit sample listing website</a></dd>
                        </div>
                    }
                    <div>
                        <dt class="font-bold text-muted">Price range</dt>
                        <dd class="mt-1">@FormatPriceRange(_restaurant.PriceRange)</dd>
                    </div>
                    <div>
                        <dt class="font-bold text-muted">Service</dt>
                        <dd class="mt-1 flex flex-wrap gap-2">
                            @if (_restaurant.SupportsDineIn)
                            {
                                <span class="rounded-full bg-[#f8f3ec] px-3 py-1 text-xs font-bold">Dine in</span>
                            }
                            @if (_restaurant.SupportsTakeout)
                            {
                                <span class="rounded-full bg-[#f8f3ec] px-3 py-1 text-xs font-bold">Takeout</span>
                            }
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-2xl border border-[#eee4d8] bg-white p-5" aria-labelledby="hours-heading">
                <h2 id="hours-heading" class="text-lg font-extrabold">Sample hours</h2>
                @if (_restaurant.Hours.Count == 0)
                {
                    <p class="mt-3 text-sm text-muted">Hours are not listed in this sample.</p>
                }
                else
                {
                    <dl class="mt-3 space-y-2 text-sm">
                        @foreach (var hour in _restaurant.Hours.OrderBy(hour => (int)hour.DayOfWeek))
                        {
                            <div class="flex justify-between gap-3">
                                <dt class="font-semibold">@hour.DayOfWeek</dt>
                                <dd class="text-right text-muted">@FormatHours(hour)</dd>
                            </div>
                        }
                    </dl>
                }
            </section>

            <p class="rounded-xl border border-[#f0d2c6] bg-[#fff4ef] p-4 text-xs leading-relaxed text-[#794237]">
                This is fictional demo information, not a real menu or dietary assurance. Ingredients, cross-contact, prices, hours and availability can change. Confirm details directly with the restaurant before ordering.
            </p>
        </aside>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private Restaurant? _restaurant;
    private bool _isLoading = true;
    private string? _loadError;

    protected override Task OnParametersSetAsync() => LoadRestaurantAsync();

    private async Task LoadRestaurantAsync()
    {
        _isLoading = true;
        _loadError = null;
        _restaurant = null;

        try
        {
            _restaurant = await RestaurantRepository.GetPublishedBySlugAsync(Slug.Trim().ToLowerInvariant());
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load restaurant details for slug {RestaurantSlug}.", Slug);
            _loadError = "Please try again. If the problem continues, come back later.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatEvidence(AllergenEvidenceStatus status) => status switch
    {
        AllergenEvidenceStatus.Contains => "listed as present",
        AllergenEvidenceStatus.MayContainCrossContact => "may be present through cross-contact",
        AllergenEvidenceStatus.VerifiedAbsent => "marked absent in sample data",
        _ => "unknown"
    };

    private static string FormatHours(RestaurantHour hour)
    {
        if (hour.IsClosed)
        {
            return "Closed";
        }

        if (hour.OpensAt is not { } opensAt || hour.ClosesAt is not { } closesAt)
        {
            return "Hours not listed";
        }

        return $"{opensAt.ToString("HH:mm", CultureInfo.InvariantCulture)}–{closesAt.ToString("HH:mm", CultureInfo.InvariantCulture)}";
    }

    private static string FormatPriceRange(int priceRange) =>
        priceRange is >= 1 and <= 3 ? string.Concat(Enumerable.Repeat("₱", priceRange)) : "Price varies";

    private static string? TryGetHttpWebsite(string? value) =>
        Uri.TryCreate(value, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
            ? uri.ToString()
            : null;
}
