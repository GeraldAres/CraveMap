@page "/Error"
@layout MainLayout

<PageTitle>Something went wrong — CraveMap</PageTitle>
<section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <span class="mx-auto grid size-20 place-items-center rounded-[1.75rem] bg-[#fff0e8] text-4xl" aria-hidden="true">🥣</span>
    <p class="mt-6 text-xs font-extrabold uppercase tracking-[0.16em] text-tomato-dark">A little kitchen hiccup</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">We couldn’t load that just now.</h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">Please try again. If the issue continues, come back in a moment.</p>
    <NavLink href="/" class="mt-7 inline-flex min-h-12 items-center justify-center rounded-full bg-tomato px-6 font-extrabold text-white hover:bg-tomato-dark">Return home</NavLink>
</section>
